# Stacks Network Configuration
NEXT_PUBLIC_STACKS_NETWORK=mainnet
# Options: mainnet, testnet, devnet

# Contract Information (Stacks mainnet)
NEXT_PUBLIC_CONTRACT_ADDRESS=SP1V72500C63KN9E348QDK9X879MASSTN0J3KBQ5N
NEXT_PUBLIC_CONTRACT_NAME=b2s-token-v4

# Stacks API
NEXT_PUBLIC_STACKS_API_URL=https://api.mainnet.hiro.so
# Testnet: https://api.testnet.hiro.so

# Base Network RPC (for cross-chain data)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# AI Agent — REQUIRED for /api/agent (B2S Agent powered by Claude Haiku)
# Get your key at https://console.anthropic.com
# Also set this in Vercel → Project Settings → Environment Variables
ANTHROPIC_API_KEY=

# CoinGecko API key (server-side, for market data)
COINGECKO_API_KEY=

# Railway PostgreSQL — required for pool liquidity request system
# Add a PostgreSQL addon in Railway dashboard, then copy the connection string
DATABASE_URL=

# GitHub — required for pool request GitHub Issues integration
# Create a fine-grained personal access token at https://github.com/settings/tokens
# Permissions needed: Issues (read + write) on wkalidev/base2stacks-tracker
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only
GITHUB_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_STAKING=true
NEXT_PUBLIC_ENABLE_DAILY_CLAIMS=true
NEXT_PUBLIC_ENABLE_BRIDGE_TRACKING=true
